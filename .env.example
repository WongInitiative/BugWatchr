# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# Prisma / Supabase (Postgres)
# Copy both strings from the Supabase dashboard's "Connect" panel.
#
# DATABASE_URL = Transaction pooler (port 6543). Used by the app at runtime.
#   Serverless functions open many short-lived connections, so the pooler is
#   required on Vercel. `pgbouncer=true` is what stops Prisma from using
#   prepared statements, which transaction-mode pooling cannot support.
#
# DIRECT_URL = Session pooler (port 5432). Used only by `prisma migrate`.
#   Do NOT use the string labelled "Direct connection" here: on Supabase's free
#   plan that host is IPv6-only, so it fails to resolve on most networks. The
#   session pooler is the IPv4-reachable equivalent.
#
# Note the pooler username is `postgres.<PROJECT-REF>`, not plain `postgres`,
# and any of @ : / # in the password must be percent-encoded.
#
# Prisma requires BOTH to be set even for commands that only use one of them,
# because prisma/schema.prisma references each via env().
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# Clerk
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Tell Clerk the in-app auth pages exist, so auth.protect() and <SignInButton>
# redirect here instead of Clerk's hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
